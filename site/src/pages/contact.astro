---
import Base from '../layouts/Base.astro';
---
<Base title="Contact | EBT Places" desc="Report an outdated restaurant listing or a location that no longer accepts EBT.">
<main class="wrap">
  <h1 style="font-size:1.6rem">Contact</h1>
  <p class="lede">Found a restaurant that no longer accepts EBT, or one we're missing?</p>
  <p>Email <strong>info@ebtplaces.com</strong> with the restaurant name and city. We verify against the USDA data before updating.</p>
  <div class="nota"><strong>Please note:</strong> we're not a SNAP agency. We can't check your case, enroll you, or confirm your personal eligibility — for that, contact your state SNAP office.</div>
</main>
</Base>
