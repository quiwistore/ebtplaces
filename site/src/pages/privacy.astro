---
import L from '../data/legal.json';
import LS from '../data/contacto.json';
import Base from '../layouts/Base.astro';
---
<Base title="Privacy Policy | EBT Places" desc="Privacy policy for ebtplaces.com: we collect no personal, benefit, or eligibility information.">
<main class="wrap">
  <h1 style="font-size:1.6rem">Privacy policy</h1>
<Fragment set:html={L['privacy'].html.replaceAll('{{EMAIL}}', LS.email)} />
</main>
</Base>
